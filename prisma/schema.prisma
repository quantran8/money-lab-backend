generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["budget", "invest", "public"]
}

model AppUser {
  id                    String                 @id @db.Uuid
  email                 String?                @unique
  username              String?                @unique
  region                String?
  avatar                String?
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updated_at            DateTime               @default(now()) @db.Timestamptz(6)
  runs                  Run[]
  jobStates             UserJobState[]
  portfolioPositions    PortfolioPosition[]
  portfolioTransactions PortfolioTransaction[]
  credits               UserCredit?
  userLessonProgress    UserLessonProgress[]
  moduleProgresses      UserModuleProgress[]

  @@map("app_user")
  @@schema("public")
}

model Module {
  id                  Int                  @id @default(autoincrement()) @db.SmallInt
  code                String               @unique
  title               String
  description         String?
  sortOrder           Int                  @default(0) @map("sort_order") @db.SmallInt
  config              Json                 @default("{}")
  commitmentTemplates CommitmentTemplate[]
  eventPoolWeights    EventPoolWeight[]
  lifeEventTemplates  LifeEventTemplate[]
  runs                Run[]
  lessons             Lesson[]
  userProgresses      UserModuleProgress[]

  @@map("modules")
  @@schema("public")
}

model UserModuleProgress {
  id          BigInt    @id @default(autoincrement())
  userId      String    @map("user_id") @db.Uuid
  moduleId    Int       @map("module_id") @db.SmallInt
  status      String    @default("locked")
  score       Int?
  unlockedAt  DateTime? @map("unlocked_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  updated_at  DateTime  @default(now()) @db.Timestamptz(6)
  module      Module    @relation(fields: [moduleId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user        AppUser   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, moduleId])
  @@index([userId], map: "idx_ump_user")
  @@map("user_module_progress")
  @@schema("public")
}

model Lesson {
  id                 BigInt               @id @default(autoincrement())
  moduleId           Int                  @map("module_id") @db.SmallInt
  title              String
  lessonType         String               @map("lesson_type")
  orderIndex         Int                  @default(0) @map("order_index")
  estimatedSeconds   Int                  @default(0) @map("estimated_seconds")
  content            Json                 @default("{}")
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  module             Module               @relation(fields: [moduleId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  userLessonProgress UserLessonProgress[]

  @@index([moduleId, orderIndex], map: "idx_lessons_module_order")
  @@map("lessons")
  @@schema("public")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model UserLessonProgress {
  id            BigInt    @id @default(autoincrement())
  userId        String    @map("user_id") @db.Uuid
  lessonId      BigInt    @map("lesson_id")
  status        String    @default("not_started")
  bestScore     Int?      @map("best_score")
  lastAttemptAt DateTime? @map("last_attempt_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  lessons       Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  appUser       AppUser   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, lessonId])
  @@index([lessonId], map: "idx_ulp_lesson")
  @@index([userId], map: "idx_ulp_user")
  @@map("user_lesson_progress")
  @@schema("public")
}

model EventPoolWeight {
  id            BigInt  @id @default(autoincrement())
  moduleId      Int     @map("module_id") @db.SmallInt
  lqiState      String  @map("lqi_state")
  eventCategory String  @map("event_category")
  weight        Decimal @db.Decimal
  module        Module  @relation(fields: [moduleId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([moduleId, lqiState], map: "idx_event_pool_weights_module_lqi")
  @@map("event_pool_weights")
  @@schema("budget")
}

model Job {
  id                    BigInt         @id @default(autoincrement())
  name                  String
  description           String?
  baseMonthlyIncome     Int            @map("base_monthly_income")
  incomeVarianceMin     Int            @default(0) @map("income_variance_min")
  incomeVarianceMax     Int            @default(0) @map("income_variance_max")
  overtimeIncomePerUnit Int            @default(0) @map("overtime_income_per_unit")
  overtimeHealthPenalty Int            @default(0) @map("overtime_health_penalty") @db.SmallInt
  createdAt             DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  incomeStability       String?        @map("income_stability")
  stressProfile         String?        @map("stress_profile")
  baseEnergyLoad        Int            @map("base_energy_load")
  levels                JobLevel[]
  jobStates             UserJobState[]

  @@map("jobs")
  @@schema("budget")
}

model JobLevel {
  id                     BigInt   @id @default(autoincrement())
  jobId                  BigInt   @map("job_id")
  level                  Int
  rankLabel              String?  @map("rank_label")
  titlePrefix            String?  @map("title_prefix")
  incomeVarianceMin      Int?     @map("income_variance_min")
  incomeVarianceMax      Int?     @map("income_variance_max")
  overtimeIncomePerUnit  Int?     @map("overtime_income_per_unit")
  overtimeHealthPenalty  Int?     @map("overtime_health_penalty") @db.SmallInt
  xpRequiredTotal        Int      @default(0) @map("xp_required_total")
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  baseEnergyLoadOverride Int      @map("base_energy_load_override")
  absenceDeductionPerDay Int      @default(0) @map("absence_deduction_per_day")
  overtimeSpawnWeight    Decimal  @default(0) @map("overtime_spawn_weight") @db.Decimal(6, 2)
  overtimeMonthlyCap     Int      @default(1) @map("overtime_monthly_cap") @db.SmallInt
  minHiForOvertime       Int      @default(55) @map("min_hi_for_overtime") @db.SmallInt
  incomeMultiplier       Decimal  @default(1) @map("income_multiplier") @db.Decimal(8, 4)
  job                    Job      @relation(fields: [jobId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([jobId, level])
  @@index([jobId], map: "idx_job_levels_job")
  @@map("job_levels")
  @@schema("budget")
}

model UserJobState {
  id                   BigInt   @id @default(autoincrement())
  userId               String   @map("user_id") @db.Uuid
  jobId                BigInt   @map("job_id")
  level                Int      @default(1)
  xp                   Int      @default(0)
  currentMonthlyIncome Int      @default(0) @map("current_monthly_income")
  isActive             Boolean  @default(true) @map("is_active")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  runs                 Run[]
  job                  Job      @relation(fields: [jobId], references: [id], onUpdate: NoAction)
  user                 AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([jobId], map: "idx_user_job_state_job")
  @@index([userId], map: "idx_user_job_state_user")
  @@map("user_job_state")
  @@schema("budget")
}

model Run {
  id                    BigInt              @id @default(autoincrement())
  userId                String              @map("user_id") @db.Uuid
  moduleId              Int                 @map("module_id") @db.SmallInt
  jobStateId            BigInt              @map("job_state_id")
  startedAt             DateTime            @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt            DateTime?           @map("finished_at") @db.Timestamptz(6)
  totalMonths           Int                 @default(0) @map("total_months")
  finalFutureYouSavings Int                 @default(0) @map("final_future_you_savings")
  passed                Boolean             @default(false)
  months                RunMonth[]
  jobState              UserJobState        @relation(fields: [jobStateId], references: [id], onUpdate: NoAction)
  module                Module              @relation(fields: [moduleId], references: [id], onUpdate: NoAction)
  user                  AppUser             @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  commitments           UserRunCommitment[]

  @@index([jobStateId], map: "idx_runs_job_state")
  @@index([moduleId], map: "idx_runs_module")
  @@index([userId], map: "idx_runs_user")
  @@map("runs")
  @@schema("budget")
}

model CommitmentTemplate {
  id                    BigInt              @id @default(autoincrement())
  moduleId              Int                 @map("module_id") @db.SmallInt
  layer                 String
  category              String
  name                  String
  description           String?
  baseMonthlyAmount     Int                 @default(0) @map("base_monthly_amount")
  varianceMin           Int                 @default(0) @map("variance_min")
  varianceMax           Int                 @default(0) @map("variance_max")
  sortOrder             Int                 @default(0) @map("sort_order") @db.SmallInt
  isOptional            Boolean             @default(false) @map("is_optional")
  createdAt             DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  impact                Json                @default("{}")
  dissolvesIntoCategory String?             @map("dissolves_into_category")
  module                Module              @relation(fields: [moduleId], references: [id], onUpdate: NoAction)
  userCommitments       UserRunCommitment[]

  @@index([layer], map: "idx_commitment_templates_layer")
  @@index([moduleId], map: "idx_commitment_templates_module")
  @@map("commitment_templates")
  @@schema("budget")
}

model UserRunCommitment {
  id                      BigInt             @id @default(autoincrement())
  runId                   BigInt             @map("run_id")
  commitmentTemplateId    BigInt             @map("commitment_template_id")
  selectedAmount          Int                @default(0) @map("selected_amount")
  createdAt               DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  effectiveFromMonthIndex Int                @default(1) @map("effective_from_month_index")
  effectiveToMonthIndex   Int?               @map("effective_to_month_index")
  template                CommitmentTemplate @relation(fields: [commitmentTemplateId], references: [id], onUpdate: NoAction)
  run                     Run                @relation(fields: [runId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([runId, commitmentTemplateId])
  @@index([runId], map: "idx_user_run_commitments_run")
  @@index([commitmentTemplateId], map: "idx_user_run_commitments_template")
  @@index([runId, effectiveFromMonthIndex, effectiveToMonthIndex], map: "idx_user_run_commitments_effective_range")
  @@index([runId, effectiveFromMonthIndex, effectiveToMonthIndex], map: "idx_urc_run_month_range")
  @@index([commitmentTemplateId], map: "idx_urc_template_id")
  @@map("user_run_commitments")
  @@schema("budget")
}

model RunMonth {
  id                               BigInt                @id @default(autoincrement())
  runId                            BigInt                @map("run_id")
  monthIndex                       Int                   @map("month_index")
  income                           Int                   @default(0)
  lockedCommitmentsTotal           Int                   @default(0) @map("locked_commitments_total")
  billsEstimated                   Int                   @default(0) @map("bills_estimated")
  billsActual                      Int?                  @default(0) @map("bills_actual")
  cumulativeFutureYou              Int                   @default(0) @map("cumulative_future_you")
  createdAt                        DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  currentWeek                      Int                   @default(0) @map("current_week") @db.SmallInt
  billReserveOptionCode            String?               @map("bill_reserve_option_code")
  spendModeCode                    String?               @map("spend_mode_code")
  structuralOvercommitmentOccurred Boolean               @default(false) @map("structural_overcommitment_occurred")
  stressModeActive                 Boolean               @default(false) @map("stress_mode_active")
  freeCash                         Float                 @default(0) @map("free_cash")
  acceptedOvertimeCount            Int                   @default(0) @map("accepted_overtime_count")
  overtimeIncomeEarned             Int                   @default(0) @map("overtime_income_earned")
  billResolution                   MonthBillResolution?
  events                           MonthEvent[]
  indexResolution                  MonthIndexResolution?
  jars                             MonthJar[]
  run                              Run                   @relation(fields: [runId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([runId, monthIndex])
  @@index([runId], map: "idx_run_months_run")
  @@map("run_months")
  @@schema("budget")
}

model MonthBillResolution {
  id                     BigInt    @id @default(autoincrement())
  monthId                BigInt    @unique @map("month_id")
  billReserveTarget      Int?      @map("bill_reserve_target")
  billReserveStart       Int?      @map("bill_reserve_start")
  billReserveEnd         Int?      @map("bill_reserve_end")
  billReconcileBreakdown Json?     @map("bill_reconcile_breakdown")
  shortfallTotal         Int?      @map("shortfall_total")
  surplusToFreeCash      Int?      @map("surplus_to_free_cash")
  createdAt              DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  month                  RunMonth  @relation(fields: [monthId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([monthId], map: "idx_month_bill_resolution_month")
  @@map("month_bill_resolution")
  @@schema("budget")
}

model MonthIndexResolution {
  id                            BigInt    @id @default(autoincrement())
  monthId                       BigInt    @unique @map("month_id")
  hiStart                       Int?      @map("hi_start") @db.SmallInt
  hiEnd                         Int?      @map("hi_end") @db.SmallInt
  lqiStart                      Int?      @map("lqi_start") @db.SmallInt
  lqiEnd                        Int?      @map("lqi_end") @db.SmallInt
  lqiStateStart                 String?   @map("lqi_state_start")
  lqiStateEnd                   String?   @map("lqi_state_end")
  baselineRecovery              Int?      @map("baseline_recovery") @db.SmallInt
  funRecoveryBonus              Int?      @map("fun_recovery_bonus") @db.SmallInt
  jobDrain                      Int?      @map("job_drain") @db.SmallInt
  eventHiEffectTotal            Int?      @map("event_hi_effect_total") @db.SmallInt
  stressEffect                  Int?      @map("stress_effect") @db.SmallInt
  hiNetChange                   Int?      @map("hi_net_change") @db.SmallInt
  baselineRecoveryEfficiencyPct Decimal?  @map("baseline_recovery_efficiency_pct") @db.Decimal
  funRecoveryEfficiencyPct      Decimal?  @map("fun_recovery_efficiency_pct") @db.Decimal
  eventPoolBiasState            String?   @map("event_pool_bias_state")
  forcedRestWeek                Int?      @map("forced_rest_week") @db.SmallInt
  incomeLossFromForcedRest      Int?      @map("income_loss_from_forced_rest")
  hiRecoveryFromForcedRest      Int?      @map("hi_recovery_from_forced_rest") @db.SmallInt
  createdAt                     DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  weeklyIndexProgress           Json      @default("{}") @map("weekly_index_progress")
  month                         RunMonth  @relation(fields: [monthId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([monthId], map: "idx_month_index_resolution_month")
  @@map("month_index_resolution")
  @@schema("budget")
}

model MonthJar {
  id                  BigInt   @id @default(autoincrement())
  monthId             BigInt   @map("month_id")
  jarCode             String   @map("jar_code")
  allocatedAmount     Int      @default(0) @map("allocated_amount")
  spentAmount         Int      @default(0) @map("spent_amount")
  overflowInAmount    Int      @default(0) @map("overflow_in_amount")
  overflowOutAmount   Int      @default(0) @map("overflow_out_amount")
  remainingBalanceEnd Int      @default(0) @map("remaining_balance_end")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  month               RunMonth @relation(fields: [monthId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([monthId, jarCode], map: "month_jars_unique")
  @@map("month_jars")
  @@schema("budget")
}

model LifeEventTemplate {
  id           BigInt            @id @default(autoincrement())
  moduleId     Int               @map("module_id") @db.SmallInt
  title        String
  description  String?
  category     String?
  rarity       Int               @default(1) @db.SmallInt
  meta         Json              @default("{}")
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  eventSource  String            @default("life") @map("event_source")
  eventSubtype String?           @map("event_subtype")
  options      LifeEventOption[]
  module       Module            @relation(fields: [moduleId], references: [id], onUpdate: NoAction)
  events       MonthEvent[]

  @@index([moduleId], map: "idx_life_event_templates_module")
  @@map("life_event_templates")
  @@schema("budget")
}

model LifeEventOption {
  id              BigInt            @id @default(autoincrement())
  eventTemplateId BigInt            @map("event_template_id")
  optionLabel     String            @map("option_label")
  description     String?
  moneyDelta      Int               @default(0) @map("money_delta")
  healthDelta     Int               @default(0) @map("health_delta") @db.SmallInt
  lqiDelta        Int               @default(0) @map("lqi_delta") @db.SmallInt
  learningXpDelta Int               @default(0) @map("learning_xp_delta")
  sortOrder       Int               @default(0) @map("sort_order")
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  moneyJarCode    String?           @map("default_jar_code")
  template        LifeEventTemplate @relation(fields: [eventTemplateId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  events          MonthEvent[]

  @@index([eventTemplateId], map: "idx_life_event_options_template")
  @@map("life_event_options")
  @@schema("budget")
}

model MonthEvent {
  id               BigInt            @id @default(autoincrement())
  monthId          BigInt            @map("month_id")
  eventTemplateId  BigInt            @map("event_template_id")
  chosenOptionId   BigInt?           @map("chosen_option_id")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  week             Int?              @db.SmallInt
  paymentBreakdown Json?             @map("payment_breakdown")
  eventSource      String?           @map("event_source")
  eventSubtype     String?           @map("event_subtype")
  option           LifeEventOption?  @relation(fields: [chosenOptionId], references: [id], onUpdate: NoAction)
  template         LifeEventTemplate @relation(fields: [eventTemplateId], references: [id], onUpdate: NoAction)
  month            RunMonth          @relation(fields: [monthId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([monthId, week, eventSource], map: "uq_month_events_month_week_source")
  @@index([monthId], map: "idx_month_events_month")
  @@index([chosenOptionId], map: "idx_month_events_option")
  @@index([eventTemplateId], map: "idx_month_events_template")
  @@index([monthId, week, chosenOptionId], map: "idx_month_events_month_week_chosen")
  @@map("month_events")
  @@schema("budget")
}

model Sector {
  id                Int                   @id @default(autoincrement()) @db.SmallInt
  code              String                @unique
  name              String
  description       String?
  sortOrder         Int                   @default(0) @map("sort_order") @db.SmallInt
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  assets            Asset[]
  newsSectorImpacts SimNewsSectorImpact[]
  arcSectorImpacts     WorldArcSectorImpact[]
  policySectorImpacts  PolicySectorImpact[]

  @@map("sectors")
  @@schema("invest")
}

model Asset {
  id                   BigInt                   @id @default(autoincrement())
  sectorId             Int                      @map("sector_id") @db.SmallInt
  code                 String                   @unique
  name                 String
  assetType            String                   @map("asset_type")
  riskTier             String                   @map("risk_tier")
  volatilityProfile    String                   @map("volatility_profile")
  attentionSensitivity String                   @map("attention_sensitivity")
  description          String?
  category             String?
  meta                 Json                     @default("{}")
  isActive             Boolean                  @default(true) @map("is_active")
  createdAt            DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  pricePoints          AssetPricePoint[]
  spotlightInstances   AssetSpotlightInstance[]
  sector               Sector                   @relation(fields: [sectorId], references: [id], onUpdate: NoAction)
  positions            PortfolioPosition[]
  transactions         PortfolioTransaction[]
  newsAssetImpacts     SimNewsAssetImpact[]
  arcAssetAffinities   ArcAssetAffinity[]

  @@index([sectorId], map: "idx_assets_sector")
  @@index([assetType], map: "idx_assets_type")
  @@map("assets")
  @@schema("invest")
}

model MarketTick {
  id                   BigInt                   @id @default(autoincrement())
  tickIndex            BigInt                   @unique @map("tick_index")
  simDay               Int                      @default(0) @map("sim_day")
  simMonth             Int                      @default(0) @map("sim_month")
  simYear              Int                      @default(0) @map("sim_year")
  createdAt            DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  pricePoints          AssetPricePoint[]
  behaviorWindowEnds   BehaviorWindow[]         @relation("BehaviorWindowEndTick")
  behaviorWindowStarts BehaviorWindow[]         @relation("BehaviorWindowStartTick")
  events               MarketEventLog[]
  transactions         PortfolioTransaction[]
  newsItems            SimNewsItem[]
  portfolioSnapshots   PortfolioValueSnapshot[]
  reports              SimReport[]
  reflections          UserReflection[]
  stabilityMetrics     UserStabilityMetric[]
  worldState           WorldStateAtTick?

  @@map("market_ticks")
  @@schema("invest")
}

model WorldStateAtTick {
  id        BigInt     @id @default(autoincrement())
  tickId    BigInt     @unique @map("tick_id")
  stateData Json       @default("{}") @map("state_data")
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  tick      MarketTick @relation(fields: [tickId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("world_state_at_tick")
  @@schema("invest")
}

model AssetPricePoint {
  id             BigInt     @id @default(autoincrement())
  assetId        BigInt     @map("asset_id")
  tickId         BigInt     @map("tick_id")
  price          Int
  changeFromPrev Int        @default(0) @map("change_from_prev")
  changePct      Decimal    @default(0) @map("change_pct") @db.Decimal(8, 4)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  asset          Asset      @relation(fields: [assetId], references: [id], onUpdate: NoAction)
  tick           MarketTick @relation(fields: [tickId], references: [id], onUpdate: NoAction)

  @@unique([assetId, tickId])
  @@index([tickId], map: "idx_price_points_tick")
  @@index([assetId], map: "idx_price_points_asset")
  @@map("asset_price_points")
  @@schema("invest")
}

model MarketEventTemplate {
  id           BigInt           @id @default(autoincrement())
  title        String
  description  String?
  isPositive   Boolean          @default(true) @map("is_positive")
  impactMinPct Decimal          @default(0) @map("impact_min_pct") @db.Decimal(8, 4)
  impactMaxPct Decimal          @default(0) @map("impact_max_pct") @db.Decimal(8, 4)
  rarity       Int              @default(1) @db.SmallInt
  meta         Json             @default("{}")
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  events       MarketEventLog[]

  @@map("market_event_templates")
  @@schema("invest")
}

model MarketEventLog {
  id               BigInt              @id @default(autoincrement())
  tickId           BigInt              @map("tick_id")
  eventTemplateId  BigInt              @map("event_template_id")
  appliedImpactPct Decimal             @default(0) @map("applied_impact_pct") @db.Decimal(8, 4)
  appliedMeta      Json                @default("{}") @map("applied_meta")
  occurredAt       DateTime            @default(now()) @map("occurred_at") @db.Timestamptz(6)
  template         MarketEventTemplate @relation(fields: [eventTemplateId], references: [id], onUpdate: NoAction)
  tick             MarketTick          @relation(fields: [tickId], references: [id], onUpdate: NoAction)

