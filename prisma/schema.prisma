generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["auth", "public"]
}

model Profile {
  id                   String                 @id @db.Uuid
  email                String?                @unique
  username             String?                @unique
  region               String?
  createdAt            DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updated_at           DateTime               @default(now()) @db.Timestamptz(6)
  users                users                  @relation(fields: [id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user_lesson_progress LessonProgress[]
  moduleProgresses     UserModuleProgress[]

  @@map("profiles")
  @@schema("public")
}

model Module {
  id                   Int                       @id @default(autoincrement()) @db.SmallInt
  code                 String                    @unique
  title                String
  description          String?
  sortOrder            Int                       @default(0) @map("sort_order") @db.SmallInt
  config               Json?                     @default("{}") @db.JsonB
  budgetRuns           BudgetRun[]
  commitmentTemplates  CommitmentTemplate[]
  lessons              Lesson[]
  lifeEventTemplates   LifeEventTemplate[]
  userProgresses       UserModuleProgress[]
  eventPoolWeights     ModuleEventPoolWeight[]

  @@map("modules")
  @@schema("public")
}

model UserModuleProgress {
  id          BigInt    @id @default(autoincrement())
  userId      String    @map("user_id") @db.Uuid
  moduleId    Int       @map("module_id") @db.SmallInt
  status      String    @default("locked")
  score       Int?
  unlockedAt  DateTime? @map("unlocked_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  updated_at  DateTime  @default(now()) @db.Timestamptz(6)
  module      Module    @relation(fields: [moduleId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user        Profile   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, moduleId])
  @@index([userId], map: "idx_ump_user")
  @@map("user_module_progress")
  @@schema("public")
}

model ModuleEventPoolWeight {
  id             BigInt   @id @default(autoincrement())
  moduleId       Int      @map("module_id") @db.SmallInt
  lqiState       String   @map("lqi_state")
  eventCategory  String   @map("event_category")
  weight         Decimal  @db.Decimal(5, 4)
  module         Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([moduleId], map: "idx_module_event_pool_weights_module")
  @@map("module_event_pool_weights")
  @@schema("public")
}

model Job {
  id                    BigInt         @id @default(autoincrement())
  name                  String
  description           String?
  baseMonthlyIncome     Int            @map("base_monthly_income")
  incomeVarianceMin     Int            @default(0) @map("income_variance_min")
  incomeVarianceMax     Int            @default(0) @map("income_variance_max")
  overtimeIncomePerUnit Int            @default(0) @map("overtime_income_per_unit")
  overtimeHealthPenalty Int            @default(0) @map("overtime_health_penalty") @db.SmallInt
  createdAt             DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  incomeStability       String?        @map("income_stability")
  stressProfile         String?        @map("stress_profile")
  baseEnergyLoad        Int            @map("base_energy_load")
  levels                JobLevel[]
  jobStates             UserJobState[]

  @@map("jobs")
  @@schema("public")
}

model JobLevel {
  id                     BigInt   @id @default(autoincrement())
  jobId                  BigInt   @map("job_id")
  level                  Int
  rankLabel              String?  @map("rank_label")
  titlePrefix            String?  @map("title_prefix")
  incomeMultiplier       Decimal  @default(1) @map("income_multiplier") @db.Decimal(8, 4)
  incomeVarianceMin      Int?     @map("income_variance_min")
  incomeVarianceMax      Int?     @map("income_variance_max")
  overtimeIncomePerUnit  Int?     @map("overtime_income_per_unit")
  overtimeHealthPenalty  Int?     @map("overtime_health_penalty") @db.SmallInt
  xpRequiredTotal        Int      @default(0) @map("xp_required_total")
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  baseEnergyLoadOverride Int      @map("base_energy_load_override")
  absenceDeductionPerDay Int?     @map("absence_deduction_per_day")
  overtimeSpawnWeight    Decimal  @default(0) @map("overtime_spawn_weight") @db.Decimal(5, 4)
  overtimeMonthlyCap     Int?     @map("overtime_monthly_cap")
  minHiForOvertime       Int?     @map("min_hi_for_overtime") @db.SmallInt
  job                    Job      @relation(fields: [jobId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([jobId, level])
  @@index([jobId], map: "idx_job_levels_job")
  @@map("job_levels")
  @@schema("public")
}

model UserJobState {
  id                   BigInt      @id @default(autoincrement())
  userId               String      @map("user_id") @db.Uuid
  jobId                BigInt      @map("job_id")
  level                Int         @default(1)
  xp                   Int         @default(0)
  currentMonthlyIncome Int         @default(0) @map("current_monthly_income")
  isActive             Boolean     @default(true) @map("is_active")
  createdAt            DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  budgetRuns           BudgetRun[]
  job                  Job         @relation(fields: [jobId], references: [id], onUpdate: NoAction)
  user                 users       @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([jobId], map: "idx_user_job_state_job")
  @@index([userId], map: "idx_user_job_state_user")
  @@map("user_job_state")
  @@schema("public")
}

model BudgetRun {
  id                    BigInt              @id @default(autoincrement())
  userId                String              @map("user_id") @db.Uuid
  moduleId              Int                 @map("module_id") @db.SmallInt
  jobStateId            BigInt              @map("job_state_id")
  startedAt             DateTime            @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt            DateTime?           @map("finished_at") @db.Timestamptz(6)
  totalMonths           Int                 @default(0) @map("total_months")
  finalFutureYouSavings Int                 @default(0) @map("final_future_you_savings")
  passed                Boolean             @default(false)
  months                BudgetRunMonth[]
  jobState              UserJobState        @relation(fields: [jobStateId], references: [id], onUpdate: NoAction)
  module                Module              @relation(fields: [moduleId], references: [id], onUpdate: NoAction)
  user                  users               @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  commitments           UserRunCommitment[]

  @@index([jobStateId], map: "idx_budget_runs_job_state")
  @@index([moduleId], map: "idx_budget_runs_module")
  @@index([userId], map: "idx_budget_runs_user")
  @@map("budget_runs")
  @@schema("public")
}

model CommitmentTemplate {
  id                    BigInt                   @id @default(autoincrement())
  moduleId              Int                      @map("module_id") @db.SmallInt
  layer                 String
  category              String
  name                  String
  description           String?
  baseMonthlyAmount     Int                      @default(0) @map("base_monthly_amount")
  varianceMin           Int                      @default(0) @map("variance_min")
  varianceMax           Int                      @default(0) @map("variance_max")
  sortOrder             Int                      @default(0) @map("sort_order") @db.SmallInt
  isOptional            Boolean                  @default(false) @map("is_optional")
  createdAt             DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  impact                Json                     @default("{}")
  dissolvesIntoCategory String?                  @map("dissolves_into_category")
  module                Module                   @relation(fields: [moduleId], references: [id], onUpdate: NoAction)
  utilityModifiers      HousingUtilityModifier[]
  userCommitments       UserRunCommitment[]

  @@index([layer], map: "idx_commitment_templates_layer")
  @@index([moduleId], map: "idx_commitment_templates_module")
  @@map("commitment_templates")
  @@schema("public")
}

model HousingUtilityModifier {
  id                  BigInt             @id @default(autoincrement())
  housingCommitmentId BigInt             @map("housing_commitment_id")
  utilityName         String             @map("utility_name")
  multiplier          Decimal            @db.Decimal(4, 2)
  commitment          CommitmentTemplate @relation(fields: [housingCommitmentId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "housing_utility_fk")

  @@map("housing_utility_modifiers")
  @@schema("public")
}

model UserRunCommitment {
  id                      BigInt             @id @default(autoincrement())
  budgetRunId             BigInt             @map("budget_run_id")
  commitmentTemplateId    BigInt             @map("commitment_template_id")
  selectedAmount          Int                @default(0) @map("selected_amount")
  createdAt               DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  effectiveFromMonthIndex Int                @default(1) @map("effective_from_month_index")
  effectiveToMonthIndex   Int?               @map("effective_to_month_index")
  budgetRun               BudgetRun          @relation(fields: [budgetRunId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  template                CommitmentTemplate @relation(fields: [commitmentTemplateId], references: [id], onUpdate: NoAction)

  @@unique([budgetRunId, commitmentTemplateId])
  @@index([budgetRunId], map: "idx_user_run_commitments_run")
  @@index([commitmentTemplateId], map: "idx_user_run_commitments_template")
  @@index([budgetRunId, effectiveFromMonthIndex, effectiveToMonthIndex], map: "idx_user_run_commitments_effective_range")
  @@map("user_run_commitments")
  @@schema("public")
}

model BillReserveOption {
  code        String   @id
  coveragePct Int      @map("coverage_pct") @db.SmallInt
  label       String
  description String?
  sortOrder   Int      @default(0) @map("sort_order") @db.SmallInt
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([isActive, sortOrder], map: "idx_bill_reserve_options_active")
  @@map("bill_reserve_options")
  @@schema("public")
}

model SpendModeOption {
  code        String   @id
  rate        Decimal  @db.Decimal(4, 2)
  label       String
  description String?
  sortOrder   Int      @default(0) @map("sort_order") @db.SmallInt
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([isActive, sortOrder], map: "idx_spend_mode_options_active")
  @@map("spend_mode_options")
  @@schema("public")
}

model BudgetRunMonth {
  id                               BigInt                     @id @default(autoincrement())
  budgetRunId                      BigInt                     @map("budget_run_id")
  monthIndex                       Int                        @map("month_index")
  income                           Int                        @default(0)
  lockedCommitmentsTotal           Int                        @default(0) @map("locked_commitments_total")
  billsEstimated                   Int                        @default(0) @map("bills_estimated")
  billsActual                      Int?                       @default(0) @map("bills_actual")
  cumulativeFutureYou              Int                        @default(0) @map("cumulative_future_you")
  createdAt                        DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  currentWeek                      Int                        @default(0) @map("current_week") @db.SmallInt
  billReserveOptionCode            String?                    @map("bill_reserve_option_code")
  spendModeCode                    String?                    @map("spend_mode_code")
  structuralOvercommitmentOccurred Boolean                    @default(false) @map("structural_overcommitment_occurred")
  stressModeActive                 Boolean                    @default(false) @map("stress_mode_active")
  freeCash                         Float                      @default(0) @map("free_cash")
  acceptedOvertimeCount            Int                        @default(0) @map("accepted_overtime_count")
  overtimeIncomeEarned             Int                        @default(0) @map("overtime_income_earned")
  billResolution                   BudgetMonthBillResolution?
  indexResolution                  BudgetMonthIndexResolution?
  jars                             BudgetMonthJar[]
  events                           BudgetMonthEvent[]
  budgetRun                        BudgetRun                  @relation(fields: [budgetRunId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([budgetRunId, monthIndex])
  @@index([budgetRunId], map: "idx_budget_run_months_run")
  @@map("budget_run_months")
  @@schema("public")
}

model BudgetMonthBillResolution {
  id                    BigInt          @id @default(autoincrement())
  budgetMonthId          BigInt          @unique @map("budget_month_id")
  billReserveTarget      Int             @default(0) @map("bill_reserve_target")
  billReserveStart       Int             @default(0) @map("bill_reserve_start")
  billReserveEnd         Int             @default(0) @map("bill_reserve_end")
  billReconcileBreakdown Json?           @default("{}") @map("bill_reconcile_breakdown")
  shortfallTotal         Int             @default(0) @map("shortfall_total")
  surplusToFreeCash      Int             @default(0) @map("surplus_to_free_cash")
  createdAt              DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  month                  BudgetRunMonth  @relation(fields: [budgetMonthId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([budgetMonthId], map: "idx_budget_month_bill_resolution_month")
  @@map("budget_month_bill_resolution")
  @@schema("public")
}

model BudgetMonthIndexResolution {
  id                           BigInt          @id @default(autoincrement())
  budgetMonthId                 BigInt          @unique @map("budget_month_id")
  hiStart                       Int             @default(50) @map("hi_start") @db.SmallInt
  hiEnd                         Int?            @map("hi_end") @db.SmallInt
  lqiStart                      Int             @default(50) @map("lqi_start") @db.SmallInt
  lqiEnd                        Int?            @map("lqi_end") @db.SmallInt
  lqiStateStart                 String?         @map("lqi_state_start")
  lqiStateEnd                   String?         @map("lqi_state_end")
  baselineRecovery              Int             @default(0) @map("baseline_recovery") @db.SmallInt
  funRecoveryBonus              Int             @default(0) @map("fun_recovery_bonus") @db.SmallInt
  jobDrain                      Int             @default(0) @map("job_drain") @db.SmallInt
  eventHiEffectTotal            Int             @default(0) @map("event_hi_effect_total") @db.SmallInt
  stressEffect                  Int             @default(0) @map("stress_effect") @db.SmallInt
  hiNetChange                   Int             @default(0) @map("hi_net_change") @db.SmallInt
  baselineRecoveryEfficiencyPct Decimal?        @map("baseline_recovery_efficiency_pct") @db.Decimal(5, 4)
  funRecoveryEfficiencyPct      Decimal?        @map("fun_recovery_efficiency_pct") @db.Decimal(5, 4)
  eventPoolBiasState            String?         @map("event_pool_bias_state")
  forcedRestWeek                Int?            @map("forced_rest_week") @db.SmallInt
  incomeLossFromForcedRest      Int             @default(0) @map("income_loss_from_forced_rest")
  hiRecoveryFromForcedRest      Int?            @map("hi_recovery_from_forced_rest") @db.SmallInt
  createdAt                     DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  month                         BudgetRunMonth  @relation(fields: [budgetMonthId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  weeklyIndexProgress           Json            @default("{}") @map("weekly_index_progress")

  @@index([budgetMonthId], map: "idx_budget_month_index_resolution_month")
  @@map("budget_month_index_resolution")
  @@schema("public")
}

model BudgetMonthJar {
  id                 BigInt         @id @default(autoincrement())
  budgetMonthId      BigInt         @map("budget_month_id")
  jarCode            String         @map("jar_code")
  allocatedAmount    Int            @default(0) @map("allocated_amount")
  spentAmount        Int            @default(0) @map("spent_amount")
  overflowInAmount   Int            @default(0) @map("overflow_in_amount")
  overflowOutAmount  Int            @default(0) @map("overflow_out_amount")
  remainingBalanceEnd Int           @default(0) @map("remaining_balance_end")
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  month              BudgetRunMonth @relation(fields: [budgetMonthId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([budgetMonthId, jarCode])
  @@index([budgetMonthId], map: "idx_budget_month_jars_month")
  @@map("budget_month_jars")
  @@schema("public")
}

model LifeEventTemplate {
  id          BigInt             @id @default(autoincrement())
  moduleId    Int                @map("module_id") @db.SmallInt
  title       String
  description String?
  category    String?
  eventSource String             @default("life") @map("event_source")
  eventSubtype String?           @map("event_subtype")
  rarity      Int                @default(1) @db.SmallInt
  meta        Json               @default("{}")
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  events      BudgetMonthEvent[]
  options     LifeEventOption[]
  module      Module             @relation(fields: [moduleId], references: [id], onUpdate: NoAction)

  @@index([moduleId], map: "idx_life_event_templates_module")
  @@map("life_event_templates")
  @@schema("public")
}

model LifeEventOption {
  id              BigInt             @id @default(autoincrement())
  eventTemplateId BigInt             @map("event_template_id")
  optionLabel     String             @map("option_label")
  description     String?
  moneyDelta      Int                @default(0) @map("money_delta")
  healthDelta     Int                @default(0) @map("health_delta") @db.SmallInt
  lqiDelta        Int                @default(0) @map("lqi_delta") @db.SmallInt
  learningXpDelta Int                @default(0) @map("learning_xp_delta")
  sortOrder       Int                @default(0) @map("sort_order")
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  moneyJarCode    String?            @map("default_jar_code")
  events          BudgetMonthEvent[]
  template        LifeEventTemplate  @relation(fields: [eventTemplateId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([eventTemplateId], map: "idx_life_event_options_template")
  @@map("life_event_options")
  @@schema("public")
}

model BudgetMonthEvent {
  id               BigInt            @id @default(autoincrement())
  budgetMonthId    BigInt            @map("budget_month_id")
  eventTemplateId  BigInt            @map("event_template_id")
  eventSource      String            @default("life") @map("event_source")
  eventSubtype     String?           @map("event_subtype")
  chosenOptionId   BigInt?           @map("chosen_option_id")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  week             Int?              @db.SmallInt
  paymentBreakdown Json?             @map("payment_breakdown")
  month            BudgetRunMonth    @relation(fields: [budgetMonthId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  option           LifeEventOption?  @relation(fields: [chosenOptionId], references: [id], onUpdate: NoAction)
  template         LifeEventTemplate @relation(fields: [eventTemplateId], references: [id], onUpdate: NoAction)

  @@index([budgetMonthId], map: "idx_budget_month_events_month")
  @@unique([budgetMonthId, week, eventSource], map: "uq_budget_month_events_month_week_source")
  @@index([chosenOptionId], map: "idx_budget_month_events_option")
  @@index([eventTemplateId], map: "idx_budget_month_events_template")
  @@index([budgetMonthId, week, chosenOptionId], map: "idx_budget_month_events_month_week_chosen")
  @@map("budget_month_events")
  @@schema("public")
}

model Lesson {
  id                   BigInt                 @id @default(autoincrement())
  moduleId             Int                    @map("module_id") @db.SmallInt
  title                String
  lessonType           String                 @map("lesson_type")
  orderIndex           Int                    @default(0) @map("order_index")
  estimatedSeconds     Int                    @default(0) @map("estimated_seconds")
  content              Json                   @default("{}")
  createdAt            DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  module               Module                 @relation(fields: [moduleId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user_lesson_progress LessonProgress[]

  @@index([moduleId, orderIndex], map: "idx_lessons_module_order")
  @@map("lessons")
  @@schema("public")
}

// ---------------------------------------------------------------------------
// Invest Simulation (Module 4)
// ---------------------------------------------------------------------------

model InvestSector {
  id          Int            @id @default(autoincrement()) @db.SmallInt
  code        String         @unique
  name        String
  description String?
  sortOrder   Int            @default(0) @map("sort_order") @db.SmallInt
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  assets           InvestAsset[]
  newsSectorImpacts InvestSimNewsSectorImpact[]

  @@map("invest_sectors")
  @@schema("public")
}

model InvestAsset {
  id                   BigInt                        @id @default(autoincrement())
  sectorId             Int                           @map("sector_id") @db.SmallInt
  code                 String                        @unique
  name                 String
  assetType            String                        @map("asset_type")
  riskTier             String                        @map("risk_tier")
  volatilityProfile    String                        @map("volatility_profile")
  attentionSensitivity String                        @map("attention_sensitivity")
  description          String?
  meta                 Json                          @default("{}") @db.JsonB
  isActive             Boolean                       @default(true) @map("is_active")
  createdAt            DateTime                      @default(now()) @map("created_at") @db.Timestamptz(6)
  sector               InvestSector                  @relation(fields: [sectorId], references: [id], onUpdate: NoAction)
  pricePoints          InvestAssetPricePoint[]
  positions            InvestPortfolioPosition[]
  transactions         InvestPortfolioTransaction[]
  newsAssetImpacts     InvestSimNewsAssetImpact[]
  spotlightInstances   InvestAssetSpotlightInstance[]

  @@index([sectorId], map: "idx_invest_assets_sector")
  @@index([assetType], map: "idx_invest_assets_type")
  @@map("invest_assets")
  @@schema("public")
}

model InvestMarketTick {
  id         BigInt                      @id @default(autoincrement())
  tickIndex  Int                         @unique @map("tick_index")
  simDay     Int                         @default(0) @map("sim_day")
  simMonth   Int                         @default(0) @map("sim_month")
  simYear    Int                         @default(0) @map("sim_year")
  createdAt  DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  worldState  InvestWorldStateAtTick?
  pricePoints InvestAssetPricePoint[]
  events      InvestMarketEventLog[]
  newsItems   InvestSimNewsItem[]

  @@map("invest_market_ticks")
  @@schema("public")
}

model InvestWorldStateAtTick {
  id        BigInt           @id @default(autoincrement())
  tickId    BigInt           @unique @map("tick_id")
  stateData Json             @default("{}") @map("state_data") @db.JsonB
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  tick      InvestMarketTick @relation(fields: [tickId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("invest_world_state_at_tick")
  @@schema("public")
}

model InvestAssetPricePoint {
  id             BigInt           @id @default(autoincrement())
  assetId        BigInt           @map("asset_id")
  tickId         BigInt           @map("tick_id")
  price          Int
  changeFromPrev Int              @default(0) @map("change_from_prev")
  changePct      Decimal          @default(0) @map("change_pct") @db.Decimal(8, 4)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  asset          InvestAsset      @relation(fields: [assetId], references: [id], onUpdate: NoAction)
  tick           InvestMarketTick @relation(fields: [tickId], references: [id], onUpdate: NoAction)

  @@unique([assetId, tickId])
  @@index([tickId], map: "idx_invest_price_points_tick")
  @@index([assetId], map: "idx_invest_price_points_asset")
  @@map("invest_asset_price_points")
  @@schema("public")
}

model InvestMarketEventTemplate {
  id           BigInt                 @id @default(autoincrement())
  title        String
  description  String?
  isPositive   Boolean                @default(true) @map("is_positive")
  impactMinPct Decimal                @default(0) @map("impact_min_pct") @db.Decimal(8, 4)
  impactMaxPct Decimal                @default(0) @map("impact_max_pct") @db.Decimal(8, 4)
  rarity       Int                    @default(1) @db.SmallInt
  meta         Json                   @default("{}") @db.JsonB
  createdAt    DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
