{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^#app/(.*)$": "<rootDir>/../src/$1",
    "^#budget-simulation/(.*)$": "<rootDir>/../src/budget-simulation/$1",
    "^#common/(.*)$": "<rootDir>/../src/common/$1"
  }
}
